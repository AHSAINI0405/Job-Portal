<%- include('partials/header.ejs') %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"/>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
</head>

<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 font-[Poppins]">

<!-- ================= PROFILE NOT UPDATED ================= -->
<% if(!success) { %>
<div id="updatePrompt" class="flex flex-col items-center justify-center min-h-screen gap-6">

    <div class="bg-red-600 text-white text-3xl font-bold px-10 py-5 rounded-xl shadow-2xl">
        Please Update Your Profile First
    </div>

    <button onclick="showUpdateForm()"
        class="px-10 py-4 text-xl font-semibold rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 transition">
        Update Now
    </button>

</div>
<% } %>

<!-- ================= PROFILE VIEW ================= -->
<% if(success) { %>
<div class="profile-view max-w-4xl mx-auto mt-12 p-8 rounded-2xl bg-white/90 backdrop-blur-lg shadow-2xl flex flex-col gap-6">

    <h1 class="text-4xl font-extrabold text-center text-indigo-700">
        My Professional Profile
    </h1>

    <img src="/uploads/images/<%= profile.logo %>"
         class="w-36 h-36 mx-auto rounded-full object-cover ring-4 ring-indigo-500 shadow-lg"/>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-b pb-4 text-gray-700">
        <p><strong>Full Name:</strong> <%= profile.fullname.firstname %> <%= profile.fullname.lastname %></p>
        <p><strong>Date of Birth:</strong> <%= profile.dateofbirth %></p>
        <p><strong>Age:</strong> <%= profile.age %></p>
        <p><strong>Profession:</strong> <%= profile.currentprofession %></p>
    </div>

    <div>
        <h2 class="text-xl font-bold text-indigo-600">Professional Summary</h2>
        <ul class="list-disc ml-6 text-gray-700 space-y-1">
            <% profile.summary.forEach(s => { %>
                <li><%= s %></li>
            <% }) %>
        </ul>
    </div>

    <div>
        <h2 class="text-xl font-bold text-indigo-600">Experience</h2>
        <p class="text-gray-700"><%= profile.experience %> Years</p>
    </div>

    <div>
        <h2 class="text-xl font-bold text-indigo-600">Education</h2>
        <ul class="list-disc ml-6 text-gray-700 space-y-1">
            <% profile.education.forEach(e => { %>
                <li><%= e %></li>
            <% }) %>
        </ul>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 text-gray-700">
        <p><strong>City:</strong> <%= profile.city %></p>
        <p><strong>State:</strong> <%= profile.state %></p>
    </div>

    <div class="flex flex-col md:flex-row gap-4 mt-4">
        <a href="/uploads/resumes/<%= profile.resume %>"
           class="flex-1 text-center bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700">
            View Resume
        </a>

        <button onclick="onUpdate()"
           class="flex-1 bg-emerald-500 text-white py-3 rounded-lg hover:bg-emerald-600">
            Edit Profile
        </button>
    </div>
</div>
<% } %>

<!-- ================= EDIT PROFILE FORM ================= -->
<form method="POST" action="/employee/profile" enctype="multipart/form-data" class="updateForm hidden max-w-4xl mx-auto mt-12 p-8 rounded-2xl bg-white shadow-2xl flex flex-col gap-4">

<h1 class="text-4xl font-extrabold text-center text-indigo-700 mb-4">
    Edit Profile
</h1>

<input type="file" name="logo" accept="image/*" class="border p-2 rounded"/>

<input type="text" name="fname" placeholder="First Name"
       value="<%= profile?.fullname?.firstname || '' %>"
       class="border p-2 rounded"/>

<input type="text" name="lname" placeholder="Last Name"
       value="<%= profile?.fullname?.lastname || '' %>"
       class="border p-2 rounded"/>

<textarea name="summary" placeholder="Summary"
          class="border p-2 rounded"><%= profile?.summary || '' %></textarea>

<input type="date" name="dob"
       value="<%= profile?.dateofbirth || '' %>"
       class="border p-2 rounded"/>


<textarea name="education" placeholder="Education"
          class="border p-2 rounded"><%= profile?.education || '' %></textarea>

<input type="text" name="profession" placeholder="Profession"
       value="<%= profile?.currentprofession || '' %>"
       class="border p-2 rounded"/>

<input type="number" name="experience" placeholder="Experience"
       value="<%= profile?.experience || '' %>"
       class="border p-2 rounded"/>

<input type="tel" name="mobile" placeholder="Mobile"
       value="<%= profile?.mobile || '' %>"
       class="border p-2 rounded"/>

<input type="text" name="skills" placeholder="Skills"
       value="<%= profile?.skills || '' %>"
       class="border p-2 rounded"/>

<textarea name="address" placeholder="Address"
          class="border p-2 rounded"><%= profile?.address || '' %></textarea>

<input type="text" name="city" placeholder="City"
       value="<%= profile?.city || '' %>"
       class="border p-2 rounded"/>

<input type="text" name="state" placeholder="State"
       value="<%= profile?.state || '' %>"
       class="border p-2 rounded"/>

<input type="file" name="resume" accept="application/pdf"
       class="border p-2 rounded"/>

<button type="submit"
        class="mt-4 bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 font-bold">
    Save Profile
</button>

</form>

<!-- ================= SCRIPT ================= -->
<script>
    function showUpdateForm() {
        document.getElementById("updatePrompt").style.display = "none";
        document.querySelector(".updateForm").classList.remove("hidden");
    }

    function onUpdate() {
        document.querySelector(".profile-view").style.display = "none";
        document.querySelector(".updateForm").classList.remove("hidden");
    }
</script>

</body>
</html>
